# Copiar a .env y completar con tu clave real (nunca commitear .env)
PORT=3000
CORS_ORIGIN=http://localhost:4200
GROQ_API_KEY=
# Opcional. Modelo vigente; llama-3.3-70b-versatile fue retirado en 08/2026.
GROQ_MODEL=openai/gpt-oss-120b

# Límites para uso público. Sin Upstash son por instancia; con Upstash son globales.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000
DAILY_ADAPT_LIMIT=50

# Recomendado en Vercel: Redis gratis de Upstash para tope global real.
# Si no los ponés, el contador vive en memoria de cada Function.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=tu_token_de_upstash
