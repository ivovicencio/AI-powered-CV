{
  "name": "backend-ai-cv",
  "version": "1.0.0",
  "description": "Backend TypeScript de CVOLVE",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "dev": "node -r dotenv/config --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node -r dotenv/config dist/index.js",
    "test:rate-limit": "tsx scripts/smoke-rate-limit.ts",
    "test:job-extractor": "tsx scripts/smoke-job-extractor.ts",
    "test:cv-generator": "tsx scripts/smoke-cv-generator.ts",
    "test:ai-output": "tsx scripts/smoke-ai-output.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "docx": "^9.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "groq-sdk": "^1.6.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
